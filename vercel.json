{
  "functions": {
    "api/mastery-audit.js": {
      "includeFiles": "js/config/mm-teacher-prompts.mjs"
    },
    "api/portal-serve.js": {
      "includeFiles": "mastery-method/portal/**"
    }
  },
  "routes": [
    {
      "src": "^/planner(?:/.*)?$",
      "status": 307,
      "headers": {
        "Location": "/#pressure-planner",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/liftiq(?:/index\\.html|/)?$",
      "status": 308,
      "headers": {
        "Location": "https://dispatchtalon.com/"
      }
    },
    {
      "src": "^/liftiq/how-it-works(?:/index\\.html|/)?$",
      "status": 308,
      "headers": {
        "Location": "https://dispatchtalon.com/"
      }
    },
    {
      "src": "^/liftiq/modules(?:/index\\.html|/)?$",
      "status": 308,
      "headers": {
        "Location": "https://dispatchtalon.com/"
      }
    },
    {
      "src": "^/liftiq/design-partner(?:/index\\.html|/)?$",
      "status": 308,
      "headers": {
        "Location": "https://dispatchtalon.com/"
      }
    },
    {
      "src": "^/liftiq/contact(?:/index\\.html|/)?$",
      "status": 308,
      "headers": {
        "Location": "https://dispatchtalon.com/"
      }
    },
    {
      "src": "^/liftiq/dispatch-blind-spot-diagnostic(?:/index\\.html|/)?$",
      "status": 308,
      "headers": {
        "Location": "https://dispatchtalon.com/diagnostic/"
      }
    },
    {
      "src": "^/liftiq/executive-briefing(?:/index\\.html|/)?$",
      "status": 308,
      "headers": {
        "Location": "https://dispatchtalon.com/"
      }
    },
    {
      "src": "^/liftiq/sample-preview(?:/index\\.html|/)?$",
      "status": 308,
      "headers": {
        "Location": "https://dispatchtalon.com/"
      }
    },
    {
      "src": "^/mastery-method/portal/dashboard(?:/.*)?$",
      "dest": "/api/portal-serve?page=dashboard"
    },
    {
      "src": "^/mastery-method/portal/library(?:/.*)?$",
      "dest": "/api/portal-serve?page=library"
    },
    {
      "src": "^/mastery-method/portal/module(?:/.*)?$",
      "dest": "/api/portal-serve?page=module"
    },
    {
      "src": "^/mastery-method/portal/account(?:/.*)?$",
      "dest": "/api/portal-serve?page=account"
    },
    {
      "src": "^/mastery-method/portal/progress(?:/.*)?$",
      "dest": "/api/portal-serve?page=progress"
    },
    {
      "src": "^/seminars/michael-pixley-march-2027/?$",
      "dest": "/seminars/michael-pixley-march-2027/index.html"
    },
    {
      "src": "^/seminars/([a-z0-9][a-z0-9-]*)/?$",
      "dest": "/seminars/_event/index.html"
    },
    {
      "src": "^/blueprints/([a-z0-9][a-z0-9-]*)/?$",
      "dest": "/blueprints/_blueprint/index.html"
    },
    {
      "src": "^/campaigns/([a-z0-9][a-z0-9-]*)/?$",
      "dest": "/campaigns/_campaign/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/mastery-method/portal/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Permissions-Policy",
          "value": "display-capture=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
